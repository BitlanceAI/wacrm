# Supabase service-role key. Bypasses RLS; used only by server-side
# routes (the webhook and automation engine). Keep this secret —
# never paste it into client code.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZ5Y2Zld2htdnphZHVramRmZGNtIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc2MjMyMDI4MiwiZXhwIjoyMDc3ODk2MjgyfQ.x3G2cIUZJJ7VPFzDDS38jy1JOi00othShaY1HLIdc6Y
# WhatsApp token encryption (64 hex chars = 32 bytes, AES-256-GCM).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value orphans every token encrypted under the previous
# key — users have to re-save their WhatsApp settings to reconnect.
ENCRYPTION_KEY=your-64-char-hex-key-here

# Meta App Secret (Meta for Developers → App Settings → Basic).
# Verifies the HMAC-SHA256 signature on every inbound webhook POST,
# and exchanges Embedded Signup codes for business tokens.
# Required — without it the webhook rejects every request.
META_APP_SECRET=your-meta-app-secret

# OPTIONAL — Embedded Signup ("Connect WhatsApp via Facebook" button).
# Both must be set for the button to appear; otherwise users fall back
# to pasting credentials manually.
#   NEXT_PUBLIC_META_APP_ID   — Meta for Developers → App Settings → Basic → App ID
#   NEXT_PUBLIC_META_CONFIG_ID — a Facebook Login for Business configuration
#     whose flow is "WhatsApp Embedded Signup" (Meta app dashboard →
#     Facebook Login for Business → Configurations). Requires the Meta
#     business to be verified and the app to have Advanced Access to
#     whatsapp_business_management + whatsapp_business_messaging.
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=

# ============================================================
# RECOMMENDED — safe defaults exist but you'll want to set these.
# ============================================================

# Canonical public URL of this deployment (scheme + host, no trailing
# slash). Used for the sitemap, OG images, and any email the app
# sends. Defaults to https://wacrm.tech if unset.
NEXT_PUBLIC_SITE_URL=https://crm.example.com

# ============================================================
# OPTIONAL — only needed if you use the feature.
# ============================================================

# Shared secret protecting GET /api/automations/cron. Required if you
# use Wait steps in automations (a scheduled pinger drains pending
# executions). Generate any long random string:
#   openssl rand -hex 32
# See docs/automations-and-cron.md.
# AUTOMATION_CRON_SECRET=generate-a-long-random-string

# Razorpay — online payment for WACRM subscription plans
# (Settings → Billing). Without these the plan card shows
# "Online payment isn't enabled" and everything else works.
#   Key id + secret: Razorpay dashboard → Account & Settings → API Keys
#   Webhook secret:  dashboard → Webhooks → add
#     https://<your-host>/api/razorpay/webhook with events
#     payment.captured + payment.failed, and set this same secret.
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
# RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
